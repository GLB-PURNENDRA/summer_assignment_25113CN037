#include <stdio.h>

int main()
{
    FILE *source, *target;
    char ch;

    source = fopen("student.txt", "r");
    target = fopen("copy.txt", "w");

    if(source == NULL || target == NULL)
    {
        printf("Error opening file.");
        return 0;
    }

    while((ch = fgetc(source)) != EOF)
    {
        fputc(ch, target);
    }

    printf("File copied successfully.");

    fclose(source);
    fclose(target);

    return 0;
}