#include <stdio.h>

int main()
{
    FILE *fp;
    char ch;
    int words = 0, lines = 0;

    fp = fopen("student.txt", "r");

    if(fp == NULL)
    {
        printf("File not found.");
        return 0;
    }

    while((ch = fgetc(fp)) != EOF)
    {
        if(ch == ' ' || ch == '\n')
            words++;

        if(ch == '\n')
            lines++;
    }

    fclose(fp);

    printf("Total Words = %d\n", words + 1);
    printf("Total Lines = %d\n", lines);

    return 0;
}