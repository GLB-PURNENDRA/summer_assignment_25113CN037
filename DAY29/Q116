#include <stdio.h>

int main()
{
    FILE *fp;
    char text[100];

    fp = fopen("student.txt", "a");

    if(fp == NULL)
    {
        printf("Error opening file.");
        return 0;
    }

    printf("Enter text to append: ");
    scanf(" %[^\n]", text);

    fprintf(fp, "%s\n", text);

    fclose(fp);

    printf("Data appended successfully.");

    return 0;
}