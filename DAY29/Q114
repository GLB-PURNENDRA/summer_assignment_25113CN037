#include <stdio.h>

int main()
{
    FILE *fp;
    char name[50];

    fp = fopen("student.txt", "w");

    if(fp == NULL)
    {
        printf("Error opening file.");
        return 0;
    }

    printf("Enter your name: ");
    scanf(" %[^\n]", name);

    fprintf(fp, "Name: %s\n", name);

    fclose(fp);

    printf("Data written successfully.");

    return 0;
}