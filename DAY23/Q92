#include <stdio.h>

int main()
{
    char str[100], ch;
    int i = 0, pos = -1;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    printf("Enter character to find: ");
    scanf("%c", &ch);

    while(str[i] != '\0')
    {
        if(str[i] == ch)
        {
            pos = i;
            break;
        }
        i++;
    }

    if(pos != -1)
        printf("First occurrence of '%c' is at position %d", ch, pos + 1);
    else
        printf("Character not found");

    return 0;
}