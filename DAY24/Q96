#include <stdio.h>
#include <string.h>

int main()
{
    char str[100], temp[100];
    int i, j = 0;

    printf("Enter a sentence: ");
    fgets(str, sizeof(str), stdin);

    int len = strlen(str);

    printf("Reversed Words:\n");

    for(i = len - 1; i >= 0; i--)
    {
        if(str[i] == ' ' || i == 0)
        {
            if(i == 0)
                i--;

            j = i + 1;

            while(str[j] != ' ' && str[j] != '\n' && str[j] != '\0')
            {
                printf("%c", str[j]);
                j++;
            }

            printf(" ");
        }
    }

    return 0;
}